	elseif mode == "PLAYER" then
		if isGunEquipped then
			status.Text = "PLAYER: ENTER NAME OR SELECT FROM LIST"
		else
			status.Text = "EQUIP GUN TO USE"
		end
		input.PlaceholderText = "Player name"
		updatePlayerList()
	elseif mode == "PLACE" then
		if isGunEquipped then
			status.Text = "PLACE: ENTER ID → FIRE"
		else
			status.Text = "EQUIP GUN TO USE"
		end
		input.PlaceholderText = "Place ID"
		dropdownContainer.Visible = false
	end
end

--==================================================
-- FIRE
--==================================================

local function fire()
	if not isGunEquipped then
		status.Text = "EQUIP GUN FIRST!"
		return
	end

	if currentMode == "PLAYER" then
		if input.Text == "" then
			status.Text = "ENTER PLAYER NAME OR SELECT FROM LIST"
			return
		end

		local success = firePlayerPortal(input.Text)
		if not success then
			status.Text = "PLAYER NOT FOUND"
		end
		return
	end

	if currentMode == "PLACE" then
		if input.Text == "" then
			status.Text = "ENTER PLACE ID"
			return
		end

		local success = firePlacePortal(input.Text)
		if not success then
			status.Text = "INVALID PLACE ID"
		end
		return
	end

	if currentMode == "POINT" then
		if not pointSelecting then
			startPointSelection()
		else
			status.Text = "TAP SCREEN TO SET POINT"
		end
	end
end

