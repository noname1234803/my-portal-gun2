			portal_gun = nil
			Handle = nil
			portal_sound = nil
			MuzzlePart = nil
			createGun()

			if portal_gun then
				connectTool()
				portal_gun.Parent = currentBackpack
			end
		end
	end)
end)

--==================================================
-- ОСТАНОВКА ВЫПОЛНЕНИЯ ПРИ ВЫГРУЗКЕ
--==================================================

while not shouldUnload do
    task.wait()
end

return
