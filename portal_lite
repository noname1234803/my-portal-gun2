local function createBeam(startPos, endPos)
	local distance = (endPos - startPos).Magnitude
	if distance < 0.05 then return end
	local beam = Instance.new("Part")
	beam.Name = "RickPortalBeam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanTouch = false
	beam.CanQuery = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = RICK_BLUE
	beam.Size = Vector3.new(0.18, 0.18, distance)
	beam.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
	beam.Parent = workspace
	local light = Instance.new("PointLight")
	light.Color = RICK_BLUE_LIGHT
	light.Brightness = 2
	light.Range = 6
	light.Parent = beam
	local tween = TweenService:Create(beam, TweenInfo.new(0.15), {
		Size = Vector3.new(0, 0, distance),
		Transparency = 1
	})
	tween:Play()
	tween.Completed:Connect(function() if beam then beam:Destroy() end end)
end

