	pointA = nil
	pointB = nil
	pointSelecting = false
end

--==================================================
-- АНИМАЦИЯ УДАЛЕНИЯ ПОРТАЛА (синяя)
--==================================================

local function animatePortalRemoval(portal)
    if not portal or not portal.Parent then return end
    local surface = portal:FindFirstChild("PortalTextureSurface")
    local decals = surface and surface:GetChildren() or {}
    local light = surface and surface:FindFirstChild("SoftBluePortalLight")
    local particles = surface and surface:FindFirstChild("RickPortalAttachment") 
        and surface.RickPortalAttachment:FindFirstChild("BluePortalParticles")
    
    if particles then
        particles.Rate = 0
        particles:Emit(30)
    end
    
    if surface then
        TweenService:Create(surface, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = Vector3.new(0.05, 0.05, surface.Size.Z)
        }):Play()
    end
    
    for _, decal in ipairs(decals) do
        if decal:IsA("Decal") then
            TweenService:Create(decal, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        end
    end
    
    if light then
        TweenService:Create(light, TweenInfo.new(0.3), { Brightness = 0 }):Play()
    end
    
    local flash = Instance.new("Part")
    flash.Name = "PortalRemovalFlash"
    flash.Shape = Enum.PartType.Ball
    flash.Material = Enum.Material.Neon
    flash.Color = RICK_BLUE_LIGHT
    flash.Size = Vector3.new(2, 2, 2)
    flash.Transparency = 0.3
    flash.CanCollide = false
    flash.CanTouch = false
    flash.CanQuery = false
    flash.Anchored = true
    flash.CFrame = portal.CFrame
    flash.Parent = workspace
    
    local flashLight = Instance.new("PointLight")
    flashLight.Color = RICK_BLUE_LIGHT
    flashLight.Brightness = 5
    flashLight.Range = 15
    flashLight.Parent = flash
    
    TweenService:Create(flash, TweenInfo.new(0.4), { Size = Vector3.new(8,8,8), Transparency = 1 }):Play()
    TweenService:Create(flashLight, TweenInfo.new(0.4), { Brightness = 0 }):Play()
    
    task.delay(0.4, function()
        if flash then flash:Destroy() end
        if portal then portal:Destroy() end
    end)
end

local function clearAllPortals(animated)
    if animated then
        if portalA then animatePortalRemoval(portalA); portalA = nil end
        if portalB then animatePortalRemoval(portalB); portalB = nil end
    else
        if portalA then destroyPortal(portalA); portalA = nil end
        if portalB then destroyPortal(portalB); portalB = nil end
    end
    clearPointSelection()
    teleportDebounce = false
end

