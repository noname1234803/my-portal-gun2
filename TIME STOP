-- ЗАМОРОЗКА МИРА
--==================================================

local function freezeObject(obj)
    if obj:IsA("BasePart") then
        if isMyCharacter(obj) then return end
        if obj:GetAttribute("TimeStopEffect") then return end
        if frozenParts[obj] then return end

        frozenParts[obj] = {
            cframe = obj.CFrame,
            velocity = obj.AssemblyLinearVelocity,
            angular = obj.AssemblyAngularVelocity,
            anchored = obj.Anchored
        }
        obj.AssemblyLinearVelocity = Vector3.zero
        obj.AssemblyAngularVelocity = Vector3.zero
        obj.Anchored = true

    elseif obj:IsA("Motor6D") then
        if isMyCharacter(obj) then return end
        if not frozenMotors[obj] then
            frozenMotors[obj] = obj.Transform
        end

    elseif obj:IsA("ParticleEmitter") then
        if isMyCharacter(obj) then return end
        if not frozenParticles[obj] then
            frozenParticles[obj] = {
                enabled = obj.Enabled,
                scale = obj.TimeScale
            }
            obj.Enabled = false
            obj.TimeScale = 0
        end

    elseif obj:IsA("Trail") then
        if isMyCharacter(obj) then return end
        if not frozenTrails[obj] then
            frozenTrails[obj] = obj.Enabled
            obj.Enabled = false
        end

    elseif obj:IsA("Beam") then
        if isMyCharacter(obj) then return end
        if not frozenBeams[obj] then
            frozenBeams[obj] = obj.Enabled
            obj.Enabled = false
        end

    elseif obj:IsA("Sound") then
        if isMyCharacter(obj) then return end
        if not frozenSounds[obj] then
            frozenSounds[obj] = {
                playing = obj.Playing,
                position = obj.TimePosition
            }
            if obj.Playing then
                obj:Pause()
            end
        end
    end
end

local function restoreWorld()
    for obj, data in pairs(frozenParts) do
        if obj and obj.Parent then
            obj.Anchored = data.anchored
            obj.CFrame = data.cframe
            obj.AssemblyLinearVelocity = data.velocity
            obj.AssemblyAngularVelocity = data.angular
        end
    end

    for motor, transform in pairs(frozenMotors) do
        if motor and motor.Parent then
            motor.Transform = transform
        end
    end

    for emitter, data in pairs(frozenParticles) do
        if emitter and emitter.Parent then
            emitter.Enabled = data.enabled
            emitter.TimeScale = data.scale
        end
    end

    for trail, enabled in pairs(frozenTrails) do
        if trail and trail.Parent then
            trail.Enabled = enabled
        end
    end

    for beam, enabled in pairs(frozenBeams) do
        if beam and beam.Parent then
            beam.Enabled = enabled
        end
    end

    for sound, data in pairs(frozenSounds) do
        if sound and sound.Parent then
            sound.TimePosition = data.position
            if data.playing then
                sound:Resume()
            end
        end
    end

    table.clear(frozenParts)
    table.clear(frozenMotors)
    table.clear(frozenParticles)
    table.clear(frozenTrails)
    table.clear(frozenBeams)
    table.clear(frozenSounds)
end

local function maintainFreeze()
    if not timeStopped then return end

    local now = os.clock()
    if now - lastFreezeUpdate < FREEZE_UPDATE then return end
    lastFreezeUpdate = now

    for obj, data in pairs(frozenParts) do
        if obj and obj.Parent then
            if not isMyCharacter(obj) then
                if not obj.Anchored then
                    obj.CFrame = data.cframe
                    obj.AssemblyLinearVelocity = Vector3.zero
                    obj.AssemblyAngularVelocity = Vector3.zero
                    obj.Anchored = true
                end
            end
        end
    end

    for motor, transform in pairs(frozenMotors) do
        if motor and motor.Parent then
            if not isMyCharacter(motor) then
                motor.Transform = transform
            end
        end
    end
end

--==================================================
-- NOCLIP
--==================================================

local function enableNoclip()
    local character = getCharacter()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            noclipData[part] = part.CanCollide
            part.CanCollide = false
        end
    end
end

local function disableNoclip()
    local character = getCharacter()
    if not character then return end
    for part, oldValue in pairs(noclipData) do
        if part and part.Parent then
            part.CanCollide = oldValue
        end
    end
    table.clear(noclipData)
end

--==================================================
-- DESYNC + FLY (исправлено направление)
--==================================================

local function startDesync()
    local root = getRoot()
    if not root then return end

    savedRootCFrame = root.CFrame
    isDesyncing = true
    isFlying = true

    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = true
    end

    if moveUpdateConnection then moveUpdateConnection:Disconnect() end
    moveUpdateConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not isDesyncing then return end

        local root = getRoot()
        local humanoid = getHumanoid()
        if not root or not humanoid then return end

        -- Собираем ввод
        local moveVector = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVector = moveVector + Vector3.new(0, 0, 1)   -- вперёд
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVector = moveVector + Vector3.new(0, 0, -1)  -- назад
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVector = moveVector + Vector3.new(-1, 0, 0)  -- влево
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVector = moveVector + Vector3.new(1, 0, 0)   -- вправо
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVector = moveVector + Vector3.new(0, 1, 0)   -- вверх
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveVector = moveVector + Vector3.new(0, -1, 0)  -- вниз
        end

        if moveVector.Magnitude > 0 then
            moveVector = moveVector.Unit
            local camera = workspace.CurrentCamera
            if camera then
                local forward = camera.CFrame.LookVector
                local right = camera.CFrame.RightVector
                local up = camera.CFrame.UpVector
                forward = Vector3.new(forward.X, 0, forward.Z).Unit
                right = Vector3.new(right.X, 0, right.Z).Unit
                if forward.Magnitude > 0 and right.Magnitude > 0 then
                    local moveDir = (forward * moveVector.Z + right * moveVector.X + up * moveVector.Y)
                    local step = moveDir * flySpeed * deltaTime
                    root.CFrame = root.CFrame + step
                end
            else
                local step = moveVector * flySpeed * deltaTime
                root.CFrame = root.CFrame + step
            end
        end
        root.Anchored = true
    end)
end

local function stopDesync()
    isDesyncing = false
    isFlying = false
    if moveUpdateConnection then
        moveUpdateConnection:Disconnect()
        moveUpdateConnection = nil
    end

    local root = getRoot()
    if root then
        root.Anchored = false
    end

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
    end

    savedRootCFrame = nil
end

--==================================================
-- START / STOP TIME STOP
--==================================================

local function startTimeStop()
    if timeStopped then return end

    local character = getCharacter()
    if not character then return end

    local humanoid = getHumanoid()
    local root = getRoot()
    if not humanoid or not root then return end

    timeStopped = true

    table.clear(frozenParts)
    table.clear(frozenMotors)
    table.clear(frozenParticles)
    table.clear(frozenTrails)
    table.clear(frozenBeams)
    table.clear(frozenSounds)

    for _, obj in ipairs(workspace:GetDescendants()) do
        freezeObject(obj)
    end

    enableNoclip()
    startDesync()

    colorEffect.Enabled = true
    status.Visible = true
end

local function stopTimeStop()
    if not timeStopped then return end

    local character = getCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local finalPosition = root and root.Position or nil

    timeStopped = false

    stopDesync()
    restoreWorld()
    disableNoclip()

    colorEffect.Enabled = false
    status.Visible = false

    if finalPosition then
        task.defer(function()
            local newCharacter = player.Character
            if not newCharacter then return end
            local newRoot = newCharacter:FindFirstChild("HumanoidRootPart")
            if newRoot then
                newRoot.CFrame = CFrame.new(finalPosition)
            end
        end)
    end
end

--==================================================
-- ПОДКЛЮЧЕНИЕ ИНСТРУМЕНТА
--==================================================

local function connectTool(t)
    if not t then return end
    if t:GetAttribute("Connected") then return end
    t:SetAttribute("Connected", true)

    t.Activated:Connect(function()
        if not player.Character then return end
        if t.Parent ~= player.Character then return end
        if timeStopped then
            stopTimeStop()
        else
            startTimeStop()
        end
    end)

    t.Unequipped:Connect(function()
        if timeStopped then
            stopTimeStop()
        end
    end)
end

--==================================================
-- ВЫДАЧА ИНСТРУМЕНТА
--==================================================

local function setupStarterGear()
    local starterGear = player:WaitForChild("StarterGear")
    for _, obj in ipairs(starterGear:GetChildren()) do
        if obj.Name == TOOL_NAME then
            obj:Destroy()
        end
    end
    createTool(starterGear)
end

local function giveTool()
    local backpack = player:WaitForChild("Backpack")
    local existing = backpack:FindFirstChild(TOOL_NAME)
    if existing then
        tool = existing
        connectTool(existing)
        return
    end
    if player.Character then
        local equipped = player.Character:FindFirstChild(TOOL_NAME)
        if equipped then
            tool = equipped
            connectTool(equipped)
            return
        end
    end
    local newTool = createTool(backpack)
    tool = newTool
    connectTool(newTool)
end

setupStarterGear()
giveTool()

player.CharacterAdded:Connect(function()
    if timeStopped then stopTimeStop() end
    task.wait(0.5)
    giveTool()
    task.delay(1, giveTool)
    task.delay(2, giveTool)
end)

task.spawn(function()
    while true do
        task.wait(1)
        local backpack = player:FindFirstChild("Backpack")
        if not backpack then continue end
        local inBackpack = backpack:FindFirstChild(TOOL_NAME)
        local inCharacter = player.Character and player.Character:FindFirstChild(TOOL_NAME)
        if not inBackpack and not inCharacter then
            giveTool()
        end
    end
end)

