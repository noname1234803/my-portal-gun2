--==================================================
-- REMOVE OLD GUNS
--==================================================

local function removeOldGuns()
	local backpack = getBackpack()

	for _, container in ipairs({backpack, LocalPlayer.Character}) do
		if container then
			for _, obj in ipairs(container:GetChildren()) do
				if obj:IsA("Tool") and (
					obj.Name == "Portal_Gun"
					or obj.Name == "EVIL_MORTY_PORTAL_GUN"
					or obj.Name == "RICK_PORTAL_GUN"
				) then
					obj:Destroy()
				end
			end
		end
	end
end

