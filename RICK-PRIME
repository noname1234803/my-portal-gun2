local dragging = false
local dragStart = nil
local frameStart = nil

local function startDrag(input)
	if not frame then return end
	dragging = true
	dragStart = input.Position
	frameStart = frame.Position
end

local function updateDrag(input)
	if not dragging or not frame or not dragStart or not frameStart then return end
	
	local delta = input.Position - dragStart
	local newX = frameStart.X.Offset + delta.X
	local newY = frameStart.Y.Offset + delta.Y
	
	local screenSize = gui.AbsoluteSize
	local frameSize = frame.AbsoluteSize
	
	newX = math.max(0, math.min(screenSize.X - frameSize.X, newX))
	newY = math.max(0, math.min(screenSize.Y - frameSize.Y, newY))
	
	frame.Position = UDim2.new(0, newX, 0, newY)
end

local function endDrag()
	dragging = false
	dragStart = nil
	frameStart = nil
end

