-- CREATE PORTAL (С УЛУЧШЕНИЯМИ: ГУЛ, ТАЙМЕР, УСКОРЕННАЯ ПУЛЬСАЦИЯ)
--==================================================

local function create_portal(position, lookDirection, surfaceNormal)
	local portal = Instance.new("Part")
	portal.Name = "RickGreenPortal"
	portal.Size = Vector3.new(0.5, 0.5, 0.5)
	portal.Transparency = 1
	portal.Anchored = true
	portal.CanCollide = false
	portal.CanTouch = true
	portal.CanQuery = false
	portal.CastShadow = false

	local center

	if surfaceNormal then
		center = position + surfaceNormal * 0.06
		portal.CFrame = CFrame.lookAt(center, center + surfaceNormal)
	else
		local direction = Vector3.new(lookDirection.X, 0, lookDirection.Z)
		if direction.Magnitude < 0.01 then
			direction = Vector3.new(0, 0, -1)
		else
			direction = direction.Unit
		end
		center = position + Vector3.new(0, 2.8, 0)
		portal.CFrame = CFrame.lookAt(center, center + direction)
	end

	portal.Parent = workspace

	local surface = Instance.new("Part")
	surface.Name = "PortalTextureSurface"
	surface.Transparency = 1
	surface.Anchored = true
	surface.CanCollide = false
	surface.CanTouch = false
	surface.CanQuery = false
	surface.CastShadow = false
	surface.CFrame = portal.CFrame

	local FULL_SIZE = Vector3.new(9.3, 9.3, 0.08)
	local INITIAL_SIZE = Vector3.new(0.15, 0.15, 0.08)
	
	surface.Size = INITIAL_SIZE
	surface.Parent = portal

	local front = Instance.new("Decal")
	front.Name = "PortalTextureFront"
	front.Face = Enum.NormalId.Front
	front.Texture = PORTAL_TEXTURE
	front.Color3 = Color3.fromRGB(255, 255, 255)
	front.Transparency = 0
	front.Parent = surface

	local back = Instance.new("Decal")
	back.Name = "PortalTextureBack"
	back.Face = Enum.NormalId.Back
	back.Texture = PORTAL_TEXTURE
	back.Color3 = Color3.fromRGB(255, 255, 255)
	back.Transparency = 0
	back.Parent = surface

	local light = Instance.new("PointLight")
	light.Name = "SoftGreenPortalLight"
	light.Color = RICK_GREEN_LIGHT
	light.Brightness = 0.2
	light.Range = 10
	light.Shadows = false
	light.Parent = surface

	-- ===== ФОНОВЫЙ ЗВУК ПОРТАЛА (ГУЛ) =====
	local humSound = Instance.new("Sound")
	humSound.Name = "PortalHumSound"
	humSound.SoundId = PORTAL_HUM_SOUND
	humSound.Volume = 0.6
	humSound.Looped = true
	humSound.RollOffMode = Enum.RollOffMode.Inverse
	humSound.RollOffMaxDistance = 40
	humSound.RollOffMinDistance = 5
	humSound.Parent = portal
	humSound:Play()

	local attachment = Instance.new("Attachment")
	attachment.Name = "RickPortalAttachment"
	attachment.Parent = surface

	local particles = Instance.new("ParticleEmitter")
	particles.Name = "GreenPortalParticles"
	particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Color = ColorSequence.new(RICK_GREEN)
	particles.LightEmission = 0.9
	particles.Rate = 0
	particles.Lifetime = NumberRange.new(0.35, 0.7)
	particles.Speed = NumberRange.new(0.3, 1.2)
	particles.SpreadAngle = Vector2.new(360, 360)
	particles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.5, 0.10),
		NumberSequenceKeypoint.new(1, 0)
	})
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(1, 1)
	})
	particles.Parent = attachment

	-- РАСШИРЕНИЕ
	local expandTween = TweenService:Create(surface, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = FULL_SIZE
	})
	local lightTween = TweenService:Create(light, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = 2.0
	})
	expandTween:Play()
	lightTween:Play()
	particles:Emit(50)
	particles.Rate = 10

	-- ВРАЩЕНИЕ
	local rotation = 0
	local rotationConnection
	rotationConnection = RunService.RenderStepped:Connect(function(dt)
		if not portal or not portal.Parent then
			if rotationConnection then rotationConnection:Disconnect() end
			return
		end
		rotation += dt * 0.65
		surface.CFrame = portal.CFrame * CFrame.Angles(0, 0, rotation)
	end)

	-- ===== УСКОРЕННАЯ ПУЛЬСАЦИЯ (зависит от времени) =====
	local startTime = tick()
	local lifetime = PORTAL_LIFETIME

	task.spawn(function()
		local pulseTime = 0
		while portal and portal.Parent do
			pulseTime += 0.05
			local elapsed = tick() - startTime
			local remaining = math.max(0, lifetime - elapsed)
			local pulseSpeed = 3.0 + (1 - remaining / lifetime) * 2.0  -- ускоряется к концу
			local pulse = (math.sin(pulseTime * pulseSpeed) + 1) / 2
			
			local scale = 0.92 + pulse * 0.16
			local newSize = Vector3.new(FULL_SIZE.X * scale, FULL_SIZE.Y * scale, FULL_SIZE.Z)
			surface.Size = newSize
			
			light.Brightness = 1.2 + pulse * 1.2
			
			front.Transparency = 0.02 + pulse * 0.12
			back.Transparency = 0.02 + pulse * 0.12
			
			task.wait(0.05)
		end
	end)

	playPortalSpawnSound(portal)

	-- ===== ТАЙМЕР НА ЭКРАНЕ =====
	local portalLabel = portalA == nil and "A" or "B"
	local timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "PortalTimer"
	timerLabel.Size = UDim2.new(0, 100, 0, 30)
	timerLabel.Position = UDim2.new(0.5, -50, 0.5, 60)
	timerLabel.BackgroundTransparency = 1
	timerLabel.TextColor3 = RICK_GREEN_LIGHT
	timerLabel.TextScaled = true
	timerLabel.Font = Enum.Font.GothamBold
	timerLabel.Text = string.format("Portal %s: %.0fs", portalLabel, PORTAL_LIFETIME)
	timerLabel.Parent = gui  -- gui уже создан ниже

	local timerConnection
	timerConnection = RunService.Heartbeat:Connect(function()
		if not portal or not portal.Parent then
			if timerConnection then timerConnection:Disconnect() end
			if timerLabel then timerLabel:Destroy() end
			return
		end
		local elapsed = tick() - startTime
		local remaining = math.max(0, lifetime - elapsed)
		if remaining <= 0 then
			timerLabel.Text = "Portal " .. portalLabel .. ": CLOSED"
			if timerConnection then timerConnection:Disconnect() end
			task.delay(1, function() if timerLabel then timerLabel:Destroy() end end)
		else
			timerLabel.Text = string.format("Portal %s: %.0fs", portalLabel, remaining)
		end
	end)

	-- ===== АВТОМАТИЧЕСКОЕ ЗАКРЫТИЕ =====
	task.delay(PORTAL_LIFETIME, function()
		if portal and portal.Parent then
			if timerLabel then timerLabel:Destroy() end
			if timerConnection then timerConnection:Disconnect() end
			animatePortalRemoval(portal)
			if portal == portalA then portalA = nil end
			if portal == portalB then portalB = nil end
		end
	end)

	return portal
end

--==================================================
-- TWO WAY TELEPORT (С МАСКИРОВКОЙ)
--==================================================

local function connectPortalTeleport(entrance, destination)
	if not entrance or not destination then return end

	entrance.Touched:Connect(function(hit)
		if teleportDebounce then return end

		local character = LocalPlayer.Character
		if not character then return end
		if not hit:IsDescendantOf(character) then return end

		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		if not destination or not destination.Parent then return end

		teleportDebounce = true
		if portal_sound then portal_sound:Play() end

		local oldTransparency = {}
		local parts = {}
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(parts, part)
				oldTransparency[part] = part.Transparency
			end
		end

		for _, part in ipairs(parts) do
			TweenService:Create(part, TweenInfo.new(0.25), { Transparency = 1 }):Play()
		end

		local flashIn = Instance.new("Part")
		flashIn.Shape = Enum.PartType.Ball
		flashIn.Material = Enum.Material.Neon
		flashIn.Color = RICK_GREEN_LIGHT
		flashIn.Size = Vector3.new(2, 2, 2)
		flashIn.Transparency = 0.5
		flashIn.Anchored = true
		flashIn.CanCollide = false
		flashIn.CFrame = hrp.CFrame
		flashIn.Parent = workspace
		TweenService:Create(flashIn, TweenInfo.new(0.3), { Size = Vector3.new(5,5,5), Transparency = 1 }):Play()
		task.delay(0.4, function() flashIn:Destroy() end)

		task.wait(0.3)

		local destinationCF = destination.CFrame
		hrp.CFrame = destinationCF * CFrame.new(0, 0, -4)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		local flashOut = Instance.new("Part")
		flashOut.Shape = Enum.PartType.Ball
		flashOut.Material = Enum.Material.Neon
		flashOut.Color = RICK_GREEN_LIGHT
		flashOut.Size = Vector3.new(2, 2, 2)
		flashOut.Transparency = 0.5
		flashOut.Anchored = true
		flashOut.CanCollide = false
		flashOut.CFrame = hrp.CFrame
		flashOut.Parent = workspace
		TweenService:Create(flashOut, TweenInfo.new(0.3), { Size = Vector3.new(5,5,5), Transparency = 1 }):Play()
		task.delay(0.4, function() flashOut:Destroy() end)

		for _, part in ipairs(parts) do
			local orig = oldTransparency[part] or 0
			TweenService:Create(part, TweenInfo.new(0.25), { Transparency = orig }):Play()
		end

		task.delay(0.7, function()
			teleportDebounce = false
		end)
	end)
end

